generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  users      User[]
  tasks      Task[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("member") // "member" | "director"
  createdAt    DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  tasks Task[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String    @default("medium") // low | medium | high | urgent
  status      String    @default("planned") // planned | in_progress | done
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  doneAt      DateTime?
  deadline    DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
}

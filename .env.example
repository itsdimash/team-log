# Postgres connection string. On Vercel, add the "Postgres" or "Neon" integration
# from the Storage tab and it will fill this in for you automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# The deployed URL of your app (Vercel sets this automatically in production,
# but it's used locally too)
NEXTAUTH_URL="http://localhost:3000"
